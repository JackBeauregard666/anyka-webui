# Anyka Domecam WebUI .gitignore

# Backups & verification logs
backups/
verify/
*.log
*.bak*

# Firmware / MTD images & binary dumps
*.bin
*.img

# Camera configuration & secrets
anyka_conf.ini
wpa_supplicant.conf
ntp.conf
lan_routes.conf
.env
prompt*.txt

# Upstream firmware clones & build artifacts
src/Anyka-Camera-Firmware/
build/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class

# Temporary / OS files
.DS_Store
Thumbs.db
dist/
